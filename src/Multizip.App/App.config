<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Binding redirects are generated automatically for NuGet dependencies. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
    <!-- Large archives benefit from > 2 GB object support and server GC. -->
    <gcServer enabled="true" />
  </runtime>
</configuration>
